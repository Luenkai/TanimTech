# Copy these values into the backend process environment. Never commit real keys.
# Vision analysis (server-side only)
OPENAI_API_KEY=your-openai-compatible-key
# Optional: provider base URL, with or without /v1 or /chat/completions
OPENAI_API_BASE=https://api.openai.com/v1
# Optional: use a vision-capable model available from your provider
SOIL_VISION_MODEL=gpt-5-mini
# Optional GPT-5 reasoning setting: low, medium, or high
SOIL_REASONING=low

# Optional live plant source; the bundled 719-plant ECOCROP catalog works without it
TREFLE_TOKEN=your-trefle-token
